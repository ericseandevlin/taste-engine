node_modules/
.env
.DS_Store
*.log

# Generated page screenshots are large and re-creatable; keep the demo example,
# ignore ad-hoc captures elsewhere.
boards/*/generated/**/*.png
!boards/demo/generated/**/*.png

# Eric's private focused board: real designers' screenshots, NEVER committed (symlink into Life-OS)
/boards/swiss-focus
/boards/face-treatments
/boards/flat-layering
/boards/negative-space
/boards/experimental-type
/boards/gothic-heraldry
# Scratch board the demo gallery was built from (re-creatable from boards/demo)
/boards/gallery-run

# Posters and the result page are outputs of a run. Keep the demo's; ignore the rest.
boards/*/posters/
boards/*/result.html
!boards/demo/posters/
!boards/demo/result.html
