        "swiss-index",
        "mono-meta"
      ],
      "palette": [
        "#ffffff",
        "#000000",
        "#333333",
        "#cccccc"
      ]
    },
    {
      "id": "monolith-grid",
      "name": "Monolith Grid",
      "summary": "A brand or studio landing page where a single dominant wordmark commands the white field, supported by a strict underlying grid that keeps any secondary content, metadata, a navigation index, a tagline, tightly ordered and subordinate. The board's cream-to-white ground and black type mass anchor the identity; red appears as one restrained accent at most.",
      "lanes": [
        "monolith-wordmark",
        "swiss-index"
      ],
      "palette": [
        "#ffffff",
        "#ffffcc",
        "#000000",
        "#ff3300"
      ]
    },
    {
      "id": "brutalist-case-doc",
      "name": "Brutalist Case Doc",
      "summary": "A work or process showcase that presents documentation with aggressive graphic weight, heavy grotesk at large scale structures each section while underlying logic is strictly evidentiary: process screens, artifacts, and sequenced content blocks. The board's black-and-white ground with a single maximum-chroma red hit makes the site feel like a zine and a report simultaneously.",
      "lanes": [
        "bold-primary-brutalist",
        "case-study-functional"
      ],
      "palette": [
        "#000000",
        "#ffffff",
        "#ff3300",
        "#333333"
      ]
    },
    {
      "id": "warm-editorial-meta",
      "name": "Warm Meta Editorial",
      "summary": "A writing-forward or studio journal site where cream and blush grounds carry literary-spaced editorial type, while monospaced labels, datestamps, and category tags introduce a quiet system layer, warmth and precision held in careful tension. The board's pale yellow (#ffffcc), pink tones (#ffcccc, #ff66cc), and off-white palette ground this in softness without tipping into generic pastel.",
